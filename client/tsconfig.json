{
  "include": ["src/**/*", "wrap-with-provider.jsx", "vite.config.mts"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "allowJs": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "noEmit": true,
    "lib": ["dom", "dom.iterable", "es2019"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "*": ["./src/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "moduleResolution": "Bundler",
    "types": ["node", "vite/client"]
  }
}
